+
+  dev_class->id = "goodixtls5e0a";
+  dev_class->full_name = "Goodix TLS Fingerprint Sensor 5e0a";
+  dev_class->type = FP_DEVICE_TYPE_USB;
+  dev_class->id_table = goodix_5e0a_id_table;
