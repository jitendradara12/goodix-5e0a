+static void
+goodix5e0a_on_d6_reply (FpDevice *dev, guint8 *data, guint16 len,
+                        gpointer ssm, GError *err)
+{
+  if (err)
+    {
+      fp_warn ("5e0a session d6 reply error: %s", err->message);
+      g_error_free (err);
+    }
+  else
