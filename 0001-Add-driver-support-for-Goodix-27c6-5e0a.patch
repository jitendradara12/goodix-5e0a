+  free (raw_frame);
+
+  if (img == NULL)
+    {
+      img = fp_image_new (GOODIX_5E0A_SCALED_WIDTH, GOODIX_5E0A_SCALED_HEIGHT);
+      img->flags = FPI_IMAGE_COLORS_INVERTED;
