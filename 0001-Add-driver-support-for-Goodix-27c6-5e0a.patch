+
+    case SCAN_5E0A_UP_AE:
+      send_cmd_noreply (dev, GOODIX_CMD_QUERY_MCU_STATE,
+                        goodix_5e0a_query_ae, sizeof (goodix_5e0a_query_ae),
+                        goodix5e0a_step_cb, ssm);
