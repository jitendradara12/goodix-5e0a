   GoodixCallbackInfo *cb_info = NULL;
+  GoodixDefaultCallback cb = NULL;
 
+  if (callback)
+    {
+      cb_info = malloc (sizeof (GoodixCallbackInfo));
+      cb_info->callback = G_CALLBACK (callback);
+      cb_info->user_data = user_data;
+      cb = goodix_receive_default;
+    }
 
