+      g_message ("5e0a enrollment quality check: minutiae_count=%u (floor=%d)",
+                 minutiae_count, GOODIX_5E0A_ENROLL_MIN_MINUTIAE);
+      if (minutiae_count < GOODIX_5E0A_ENROLL_MIN_MINUTIAE)
