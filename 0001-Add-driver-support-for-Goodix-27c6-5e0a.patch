+  for (guint32 i = 0; i < GOODIX_5E0A_FRAME_SIZE; i++)
+    {
+      if (raw_frame[i] > 0)
+        {
+          total_nonzero++;
+          if (raw_frame[i] < raw_min) raw_min = raw_frame[i];
+          if (raw_frame[i] > raw_max) raw_max = raw_frame[i];
+        }
+    }
